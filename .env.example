APP_NAME=Weather Market Agent
APP_ENV=development
DATABASE_URL=sqlite:///./weather_agent.db
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
APIFY_API_TOKEN=
PM_TRADER_ENABLED=false
PM_TRADER_ALLOW_ORDER_EXECUTION=false
PM_TRADER_USE_MOCK_FALLBACK=true
PM_TRADER_COMMAND=pm-trader
PM_TRADER_TIMEOUT_SECONDS=10
USE_MOCK_MARKETS=true
USE_MOCK_WEATHER=false
INITIAL_BANKROLL=1000.0
MIN_CONFIDENCE=0.60
MIN_EDGE=0.05
MAX_TRADE_RISK_PCT=0.02
MAX_TOTAL_EXPOSURE_PCT=0.10
